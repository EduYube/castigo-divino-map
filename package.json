{
  "name": "castigo-divino-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run snapshot:verify && tsc --noEmit && vite build",
    "build:pages": "npm run snapshot:verify && tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "verify:build": "node verify-production-build.mjs",
    "verify:security": "node scripts/verify-supabase-security.mjs",
    "snapshot:generate": "node scripts/generate-public-snapshot.mjs",
    "snapshot:verify": "node scripts/verify-public-snapshot.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"public/**/*.json\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,mts}\" \"*.{js,mjs,ts,json,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check --end-of-line auto \"src/**/*.{ts,json}\" \"public/**/*.json\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,mts}\" \"*.{js,mjs,ts,json,html}\" \".github/**/*.yml\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "npm run snapshot:verify && vitest run src/data/validate.test.ts src/infrastructure/snapshot/publicCatalogSnapshot.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "supabase:init": "supabase init",
    "supabase:network": "node scripts/ensure-supabase-network.mjs",
    "supabase:start": "npm run supabase:network && supabase start --network-id castigo-divino-map-local",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:migration:list": "supabase migration list --local",
    "supabase:db:reset": "supabase db reset --local",
    "supabase:db:test": "supabase test db --local",
    "supabase:db:test:upgrade": "node scripts/test-supabase-upgrade.mjs",
    "supabase:db:test:concurrency": "node scripts/test-supabase-concurrency.mjs",
    "supabase:db:lint": "supabase db lint --local --fail-on warning",
    "supabase:db:validate": "npm run supabase:db:test:upgrade && npm run supabase:db:reset && npm run supabase:db:lint && npm run supabase:db:test && npm run supabase:db:test:concurrency",
    "supabase:types": "supabase gen types typescript --local --schema public > src/database.types.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "supabase": "2.111.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
