# Public browser configuration only.
# The same URL and publishable key are used by the anonymous public-data adapter
# and the isolated administrative Auth adapter. They are safe to expose in Vite.
# Copy this file to an ignored local environment file for local integration.
# Never add privileged Supabase keys, management tokens, database passwords,
# user session tokens, real passwords, or connection strings to this file.

VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
